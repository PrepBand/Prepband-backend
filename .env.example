# Server-only Postgres connection string. Use the Supabase dashboard's
# "Session pooler" string (Project Settings -> Database -> Connection
# string -> Session pooler), NOT "Direct connection" -
# db.<ref>.supabase.co only has an IPv6 DNS record, and several common
# deploy targets (including Render - confirmed via Supabase's own docs)
# are IPv4-only, so the direct string fails to resolve there. The pooler
# host looks like aws-0-<region>.pooler.supabase.com:5432, and its
# username is postgres.<project-ref>, not just postgres. Use the
# SQLAlchemy/psycopg3 scheme (postgresql+psycopg://...), and percent-encode
# any special character in the password (e.g. "@" -> "%40") - an
# unescaped "@" breaks URL parsing since it's also the userinfo/host
# separator. This is a real secret - never commit the filled-in value.
# /me returns a clear 503 instead of crashing until this is set.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Public project config - not secrets, same values prepband-frontend/.env
# already uses. Defaulted in app/core/config.py, so these are only needed
# here if you're pointing at a different Supabase project.
# SUPABASE_URL=https://ztiuocjlthzvuonvwjzm.supabase.co
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ISSUER=https://ztiuocjlthzvuonvwjzm.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://ztiuocjlthzvuonvwjzm.supabase.co/auth/v1/.well-known/jwks.json

# Comma-separated list of origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5180
FRONTEND_URL=http://localhost:5180

ENVIRONMENT=development
LOG_LEVEL=INFO
