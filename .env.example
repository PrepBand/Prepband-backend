# Server-only Postgres connection string (Supabase dashboard -> Project
# Settings -> Database -> Connection string -> use the "Session pooler" or
# direct connection URI, SQLAlchemy/psycopg3 style: postgresql+psycopg://...).
# This is a real secret - never commit the filled-in value.
# /me returns a clear 503 instead of crashing until this is set.
DATABASE_URL=

# Public project config - not secrets, same values prepband-frontend/.env
# already uses. Defaulted in app/core/config.py, so these are only needed
# here if you're pointing at a different Supabase project.
# SUPABASE_URL=https://ztiuocjlthzvuonvwjzm.supabase.co
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ISSUER=https://ztiuocjlthzvuonvwjzm.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://ztiuocjlthzvuonvwjzm.supabase.co/auth/v1/.well-known/jwks.json

# Comma-separated list of origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5180
FRONTEND_URL=http://localhost:5180

ENVIRONMENT=development
LOG_LEVEL=INFO
